<div class="chat-page-container">
  <div class="chat-layout">
    {{! Sidebar de canales - se extiende hasta abajo }}
    <aside class="chat-sidebar">
      <div class="sidebar-header">
        <h5>
          <i class="bi bi-chat-square-text me-2"></i>
          Canales
        </h5>
      </div>

      {{! Estado de usuarios en línea }}
      <div class="online-status">
        <i class="bi bi-circle-fill online-dot"></i>
        <span id="active-users-count">0 en línea</span>
      </div>

      {{! Lista de canales }}
      <nav class="channel-list">
        {{#each channels}}
          <a href="/chat?channel={{@key}}"
             class="channel-item {{#if (eq @key ../currentChannel)}}active{{/if}}"
             data-channel="{{@key}}">
            <i class="bi {{this.icon}} channel-icon"></i>
            <span class="channel-name">{{this.name}}</span>
            <span class="channel-count" data-channel="{{@key}}">0</span>
          </a>
        {{/each}}
      </nav>
    </aside>

    {{! Área principal del chat }}
    <main class="chat-main">
      {{! Mensajes }}
      <div class="chat-messages" id="chat-messages">
        <div class="text-center text-muted py-5">
          <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
          </div>
          <p class="mt-3">Conectando al chat...</p>
        </div>
      </div>

      {{! Indicador de "está escribiendo" }}
      <div class="typing-indicator" id="typing-indicator" style="display: none;">
        <small>
          <i class="bi bi-pencil"></i>
          <span id="typing-users"></span>
        </small>
      </div>

      {{! Formulario de envío de mensaje }}
      <div class="chat-input p-3">
        <form id="chat-form" class="d-flex gap-2 align-items-center">
          <button type="button" class="btn btn-sm" id="emoji-button" style="background: rgba(103, 250, 193, 0.2); border-color: rgba(103, 250, 193, 0.3); color: #67fac1;">
            <i class="bi bi-emoji-smile" style="font-size: 1.2rem;"></i>
          </button>
          <input
            type="text"
            id="message-input"
            class="form-control text-white"
            style="background: rgba(72, 3, 85, 0.5); border-color: rgba(204, 132, 235, 0.3);"
            placeholder="Escribe un mensaje..."
            maxlength="500"
            autocomplete="off"
            required>
          <button type="submit" class="btn" id="send-button" style="background: linear-gradient(135deg, #cc84eb, #b06cd0); color: #ecfef7; border: none;">
            <i class="bi bi-send-fill"></i>
          </button>
        </form>
        <small class="d-block mt-2" style="color: rgba(236, 254, 247, 0.5); font-size: 0.75rem;">
          <span id="char-count">0</span>/500 caracteres
        </small>

        {{! Panel de emojis }}
        <div id="emoji-picker" class="emoji-picker" style="display: none;">
