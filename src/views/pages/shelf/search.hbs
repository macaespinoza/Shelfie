<!-- Pagina de busqueda de contenido para agregar a repisa -->
<div class="container py-4">
  <!-- Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
    <div class="mb-3 mb-md-0">
      <h4 class="mb-1">
        <i class="bi bi-plus-lg me-2"></i>Agregar a "{{shelf.name}}"
      </h4>
      <p class="text-muted mb-0">
        Busca {{shelf.categoryInfo.name}} para agregar a tu repisa
      </p>
    </div>
    <a href="/shelf/{{shelf.id}}" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-2"></i>Volver a la repisa
    </a>
  </div>

  <!-- Barra de busqueda -->
  <div class="card bg-dark border-secondary mb-4">
    <div class="card-body">
      <form action="/shelf/{{shelf.id}}/search" method="GET" class="d-flex gap-2">
        <div class="input-group">
          <span class="input-group-text bg-dark border-secondary">
            <i class="bi bi-search"></i>
          </span>
          <input
            type="text"
            class="form-control bg-dark border-secondary"
            name="q"
            value="{{query}}"
            placeholder="Buscar {{shelf.categoryInfo.name}}..."
            autofocus
          >
        </div>
        <button type="submit" class="btn btn-primary">Buscar</button>
      </form>
    </div>
  </div>

  {{#if query}}
  <!-- Resultados de busqueda -->
  <h5 class="mb-3">
    <i class="bi bi-list-ul me-2"></i>Resultados para "{{query}}"
  </h5>

  {{#if searchResults.error}}
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    {{searchResults.error}}
  </div>
  {{else if searchResults.results.length}}
  <div class="row g-3">
    {{#each searchResults.results}}
    <div class="col-6 col-md-4 col-lg-3">
      <div class="card bg-dark border-secondary h-100 search-result-card {{#if ../isPortrait}}portrait{{/if}}">
        <div class="search-result-image">
          {{#if imageUrl}}
            <img src="{{imageUrl}}" alt="{{title}}" class="card-img-top">
          {{else}}
            <div class="no-image-placeholder">
              <i class="bi {{../../shelf.categoryInfo.icon}} fs-1"></i>
            </div>
          {{/if}}

          <!-- Boton de agregar overlay -->
          <div class="search-result-overlay">
            <button
              class="btn btn-success add-to-shelf-btn"
              data-external-id="{{externalId}}"
              data-title="{{title}}"
              data-image-url="{{imageUrl}}"
              data-api-source="{{apiSource}}"
              data-metadata='{{json metadata}}'
            >
              <i class="bi bi-plus-lg me-1"></i>Agregar
            </button>
          </div>
        </div>

        <div class="card-body p-2">
          <h6 class="card-title mb-1 text-truncate" title="{{title}}">{{title}}</h6>
          {{#if metadata.year}}
            <small class="text-muted">{{metadata.year}}</small>
          {{/if}}
          {{#if metadata.artist}}
            <small class="text-muted d-block text-truncate">{{metadata.artist}}</small>
          {{/if}}
          {{#if metadata.author}}
            <small class="text-muted d-block text-truncate">{{metadata.author}}</small>
          {{/if}}
          {{#if metadata.vote_average}}
            <small class="text-warning">
              <i class="bi bi-star-fill"></i> {{metadata.vote_average}}
            </small>
          {{/if}}
        </div>
      </div>
    </div>
    {{/each}}
  </div>

  <!-- Paginacion -->
  {{#if (gt searchResults.totalPages 1)}}
  <nav class="mt-4">
    <ul class="pagination justify-content-center">
      {{#if (gt currentPage 1)}}
      <li class="page-item">
        <a class="page-link bg-dark border-secondary" href="/shelf/{{shelf.id}}/search?q={{query}}&page={{subtract currentPage 1}}">
          <i class="bi bi-chevron-left"></i>
        </a>
      </li>
      {{/if}}

      <li class="page-item disabled">
        <span class="page-link bg-dark border-secondary">
          Pagina {{currentPage}} de {{searchResults.totalPages}}
        </span>
      </li>

      {{#if (lt currentPage searchResults.totalPages)}}
      <li class="page-item">
        <a class="page-link bg-dark border-secondary" href="/shelf/{{shelf.id}}/search?q={{query}}&page={{addOne currentPage}}">
          <i class="bi bi-chevron-right"></i>
        </a>
      </li>
      {{/if}}
    </ul>
  </nav>
  {{/if}}

  {{else}}
  <div class="text-center py-5">
    <i class="bi bi-search fs-1 text-muted"></i>
    <p class="text-muted mt-3">No se encontraron resultados para "{{query}}"</p>
  </div>
  {{/if}}

  {{else}}
  <!-- Contenido popular -->
  {{#if popularContent.results.length}}
  <h5 class="mb-3">
    <i class="bi bi-fire me-2 text-warning"></i>{{shelf.categoryInfo.name}} Popular
  </h5>

  <div class="row g-3">
    {{#each popularContent.results}}
    <div class="col-6 col-md-4 col-lg-3">
      <div class="card bg-dark border-secondary h-100 search-result-card {{#if ../isPortrait}}portrait{{/if}}">
        <div class="search-result-image">
          {{#if imageUrl}}
            <img src="{{imageUrl}}" alt="{{title}}" class="card-img-top">
          {{else}}
            <div class="no-image-placeholder">
              <i class="bi {{../../shelf.categoryInfo.icon}} fs-1"></i>
            </div>
          {{/if}}

          <div class="search-result-overlay">
            <button
              class="btn btn-success add-to-shelf-btn"
              data-external-id="{{externalId}}"
              data-title="{{title}}"
              data-image-url="{{imageUrl}}"
              data-api-source="{{apiSource}}"
              data-metadata='{{json metadata}}'
            >
              <i class="bi bi-plus-lg me-1"></i>Agregar
            </button>
          </div>
        </div>

        <div class="card-body p-2">
          <h6 class="card-title mb-1 text-truncate" title="{{title}}">{{title}}</h6>
          {{#if metadata.year}}
            <small class="text-muted">{{metadata.year}}</small>
          {{/if}}
          {{#if metadata.artist}}
            <small class="text-muted d-block text-truncate">{{metadata.artist}}</small>
          {{/if}}
        </div>
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <div class="text-center py-5">
    <i class="bi {{shelf.categoryInfo.icon}} fs-1 text-{{shelf.categoryInfo.color}}"></i>
    <p class="text-muted mt-3">Busca {{shelf.categoryInfo.name}} para agregar a tu repisa</p>
  </div>
  {{/if}}
  {{/if}}
</div>

<!-- Modal para agregar item con rating -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title">Agregar a la repisa</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <form action="/shelf/{{shelf.id}}/item" method="POST" id="addItemForm">
        <div class="modal-body">
          <div class="d-flex align-items-center mb-3">
            <img id="addItemImage" src="" alt="" class="rounded me-3" width="60" height="90" style="object-fit: cover;">
            <h6 id="addItemTitle" class="mb-0"></h6>
          </div>

          <!-- Campos ocultos -->
          <input type="hidden" name="externalId" id="addExternalId">
          <input type="hidden" name="title" id="addTitle">
          <input type="hidden" name="imageUrl" id="addImageUrl">
          <input type="hidden" name="apiSource" id="addApiSource">
          <input type="hidden" name="metadata" id="addMetadata">

          <!-- Rating -->
          <div class="mb-3">
            <label class="form-label">Calificacion (opcional)</label>
            <div class="rating-selector">
              {{#times 10}}
                <button type="button" class="btn btn-outline-warning btn-sm rating-btn" data-rating="{{addOne @index}}">
                  {{addOne @index}}
                </button>
              {{/times}}
            </div>
            <input type="hidden" name="rating" id="addRatingInput">
          </div>

          <!-- Resena -->
          <div class="mb-3">
            <label for="addReview" class="form-label">Resena (opcional)</label>
            <textarea
              class="form-control bg-dark border-secondary"
              id="addReview"
              name="review"
              rows="3"
              maxlength="2000"
              placeholder="Escribe tu opinion sobre este item..."
            ></textarea>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-success">
            <i class="bi bi-plus-lg me-2"></i>Agregar a la repisa
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const addModal = new bootstrap.Modal(document.getElementById('addItemModal'))

  // Manejar click en botones de agregar
  document.querySelectorAll('.add-to-shelf-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const externalId = this.dataset.externalId
      const title = this.dataset.title
      const imageUrl = this.dataset.imageUrl
      const apiSource = this.dataset.apiSource
      const metadata = this.dataset.metadata

      // Llenar el modal
      document.getElementById('addExternalId').value = externalId
      document.getElementById('addTitle').value = title
      document.getElementById('addImageUrl').value = imageUrl || ''
      document.getElementById('addApiSource').value = apiSource
      document.getElementById('addMetadata').value = metadata

      document.getElementById('addItemTitle').textContent = title
      const imgEl = document.getElementById('addItemImage')
      if (imageUrl) {
        imgEl.src = imageUrl
        imgEl.style.display = 'block'
      } else {
        imgEl.style.display = 'none'
      }

      // Resetear rating
      document.getElementById('addRatingInput').value = ''
      document.querySelectorAll('.rating-selector .rating-btn').forEach(b => {
        b.classList.remove('active', 'btn-warning')
        b.classList.add('btn-outline-warning')
      })

      // Resetear resena
      document.getElementById('addReview').value = ''

      addModal.show()
    })
  })

  // Rating selector
  document.querySelectorAll('.rating-selector .rating-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const rating = this.dataset.rating
      const container = this.closest('.rating-selector')
      const input = container.nextElementSibling

      input.value = rating

      container.querySelectorAll('.rating-btn').forEach(b => {
        b.classList.remove('active', 'btn-warning')
        b.classList.add('btn-outline-warning')
      })
      this.classList.add('active', 'btn-warning')
      this.classList.remove('btn-outline-warning')
    })
  })
})
</script>
