<!-- Pagina de crear repisa -->
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card">
        <div class="card-header">
          <h4 class="mb-0">
            <i class="bi bi-plus-square me-2"></i>Crear Nueva Repisa
          </h4>
        </div>
        <div class="card-body">
          <form action="/shelf/create" method="POST">
            <!-- Categoria -->
            <div class="mb-4">
              <label class="form-label">Categoria</label>
              <div class="row g-2">
                {{#each categories}}
                <div class="col-6 col-md-4">
                  <input
                    type="radio"
                    class="btn-check"
                    name="category"
                    id="cat_{{value}}"
                    value="{{value}}"
                    {{#if (eq ../formData.category value)}}checked{{/if}}
                    required
                  >
                  <label class="btn btn-outline-{{color}} w-100 py-3" for="cat_{{value}}">
                    {{> category-icon icon=icon}}
                    <small>{{name}}</small>
                  </label>
                </div>
                {{/each}}
              </div>
            </div>

            <!-- Nombre -->
            <div class="mb-3">
              <label for="name" class="form-label">Nombre de la repisa</label>
              <input
                type="text"
                class="form-control"
                id="name"
                name="name"
                placeholder="Ej: Mis peliculas favoritas de terror"
                value="{{formData.name}}"
                maxlength="100"
                required
              >
              <div class="form-text">Dale un nombre descriptivo a tu repisa</div>
            </div>

            <!-- Descripcion -->
            <div class="mb-3">
              <label for="description" class="form-label">Descripcion (opcional)</label>
              <textarea
                class="form-control"
                id="description"
                name="description"
                rows="3"
                maxlength="500"
                placeholder="Describe el contenido de esta repisa..."
              >{{formData.description}}</textarea>
            </div>

            <!-- Visibilidad -->
            <div class="mb-4">
              <label class="form-label">Visibilidad</label>
              <div class="d-flex flex-column gap-2">
                <div class="form-check">
                  <input
                    class="form-check-input"
                    type="radio"
                    name="visibility"
                    id="visibility_public"
                    value="public"
                    {{#if (or (eq formData.visibility 'public') (not formData.visibility))}}checked{{/if}}
                  >
                  <label class="form-check-label" for="visibility_public">
                    <i class="bi bi-globe text-success me-2"></i>Publica
                    <small class="text-muted d-block ms-4">Visible para todos los usuarios</small>
                  </label>
                </div>
                <div class="form-check">
                  <input
                    class="form-check-input"
                    type="radio"
                    name="visibility"
                    id="visibility_friends"
                    value="friends"
                    {{#if (eq formData.visibility 'friends')}}checked{{/if}}
                  >
                  <label class="form-check-label" for="visibility_friends">
                    <i class="bi bi-people text-primary me-2"></i>Solo amigos
                    <small class="text-muted d-block ms-4">Solo tus amigos pueden verla</small>
                  </label>
                </div>
                <div class="form-check">
                  <input
                    class="form-check-input"
                    type="radio"
                    name="visibility"
                    id="visibility_private"
                    value="private"
                    {{#if (eq formData.visibility 'private')}}checked{{/if}}
                  >
                  <label class="form-check-label" for="visibility_private">
                    <i class="bi bi-lock text-secondary me-2"></i>Privada
                    <small class="text-muted d-block ms-4">Solo tu puedes verla</small>
                  </label>
                </div>
              </div>
            </div>

            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-2"></i>Crear Repisa
              </button>
              <a href="/dashboard" class="btn btn-outline-secondary">Cancelar</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
