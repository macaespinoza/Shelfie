<!-- Pagina de crear repisa -->
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card bg-dark border-secondary">
        <div class="card-header">
          <h4 class="mb-0">
            <i class="bi bi-plus-square me-2"></i>Crear Nueva Repisa
          </h4>
        </div>
        <div class="card-body">
          <form action="/shelf/create" method="POST">
            <!-- Categoria -->
            <div class="mb-4">
              <label class="form-label">Categoria</label>
              <div class="row g-2">
                {{#each categories}}
                <div class="col-6 col-md-4">
                  <input
                    type="radio"
                    class="btn-check"
                    name="category"
                    id="cat_{{value}}"
                    value="{{value}}"
                    {{#if (eq ../formData.category value)}}checked{{/if}}
                    required
                  >
                  <label class="btn btn-outline-{{color}} w-100 py-3" for="cat_{{value}}">
                    <i class="bi {{icon}} fs-4 d-block mb-1"></i>
                    <small>{{name}}</small>
                  </label>
                </div>
                {{/each}}
              </div>
            </div>

            <!-- Nombre -->
            <div class="mb-3">
              <label for="name" class="form-label">Nombre de la repisa</label>
              <input
                type="text"
                class="form-control bg-dark border-secondary"
                id="name"
                name="name"
                placeholder="Ej: Mis peliculas favoritas de terror"
                value="{{formData.name}}"
                maxlength="100"
                required
              >
              <div class="form-text">Dale un nombre descriptivo a tu repisa</div>
            </div>

            <!-- Descripcion -->
            <div class="mb-3">
              <label for="description" class="form-label">Descripcion (opcional)</label>
              <textarea
                class="form-control bg-dark border-secondary"
                id="description"
                name="description"
                rows="3"
                maxlength="500"
                placeholder="Describe el contenido de esta repisa..."
              >{{formData.description}}</textarea>
            </div>

            <!-- Privacidad -->
            <div class="mb-4">
              <div class="form-check form-switch">
                <input
                  class="form-check-input"
                  type="checkbox"
                  id="isPublic"
                  name="isPublic"
                  {{#if (neq formData.isPublic false)}}checked{{/if}}
                >
                <label class="form-check-label" for="isPublic">
                  <i class="bi bi-globe me-1"></i>Repisa publica
                </label>
              </div>
              <div class="form-text">Las repisas publicas son visibles para todos los usuarios</div>
            </div>

            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-2"></i>Crear Repisa
              </button>
              <a href="/dashboard" class="btn btn-outline-secondary">Cancelar</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
