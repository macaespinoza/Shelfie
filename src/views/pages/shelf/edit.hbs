<!-- Pagina de editar repisa -->
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h4 class="mb-0">
            <i class="bi bi-pencil-square me-2"></i>Editar Repisa
          </h4>
          <a href="/shelf/{{shelf.id}}" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
          </a>
        </div>
        <div class="card-body">
          <form action="/shelf/{{shelf.id}}/edit" method="POST">
            <!-- Nombre -->
            <div class="mb-3">
              <label for="name" class="form-label">Nombre de la repisa</label>
              <input
                type="text"
                class="form-control"
                id="name"
                name="name"
                value="{{shelf.name}}"
                maxlength="100"
                required
              >
            </div>

            <!-- Descripcion -->
            <div class="mb-3">
              <label for="description" class="form-label">Descripcion (opcional)</label>
              <textarea
                class="form-control"
                id="description"
                name="description"
                rows="3"
                maxlength="500"
              >{{shelf.description}}</textarea>
            </div>

            <!-- Visibilidad -->
            <div class="mb-4">
              <label class="form-label">Visibilidad</label>
              <div class="d-flex flex-column gap-2">
                <div class="form-check">
                  <input
                    class="form-check-input"
                    type="radio"
                    name="visibility"
                    id="visibility_public"
                    value="public"
                    {{#if (or (eq shelf.visibility 'public') (and shelf.isPublic (not shelf.visibility)))}}checked{{/if}}
                  >
                  <label class="form-check-label" for="visibility_public">
                    <i class="bi bi-globe text-success me-2"></i>Publica
                    <small class="text-muted d-block ms-4">Visible para todos los usuarios</small>
                  </label>
                </div>
                <div class="form-check">
                  <input
                    class="form-check-input"
                    type="radio"
                    name="visibility"
                    id="visibility_friends"
                    value="friends"
                    {{#if (eq shelf.visibility 'friends')}}checked{{/if}}
                  >
                  <label class="form-check-label" for="visibility_friends">
                    <i class="bi bi-people text-primary me-2"></i>Solo amigos
                    <small class="text-muted d-block ms-4">Solo tus amigos pueden verla</small>
                  </label>
                </div>
                <div class="form-check">
                  <input
                    class="form-check-input"
                    type="radio"
                    name="visibility"
                    id="visibility_private"
                    value="private"
                    {{#if (or (eq shelf.visibility 'private') (and (not shelf.isPublic) (not shelf.visibility)))}}checked{{/if}}
                  >
                  <label class="form-check-label" for="visibility_private">
                    <i class="bi bi-lock text-secondary me-2"></i>Privada
                    <small class="text-muted d-block ms-4">Solo tu puedes verla</small>
                  </label>
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-between">
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-2"></i>Guardar Cambios
              </button>

              <!-- Boton eliminar -->
              <button
                type="button"
                class="btn btn-outline-danger"
                data-bs-toggle="modal"
                data-bs-target="#deleteModal"
              >
                <i class="bi bi-trash me-2"></i>Eliminar
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal de confirmacion de eliminacion -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title text-danger">
          <i class="bi bi-exclamation-triangle me-2"></i>Eliminar Repisa
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <p>Estas seguro de que quieres eliminar la repisa <strong>"{{shelf.name}}"</strong>?</p>
        <p class="text-danger mb-0">
          <i class="bi bi-exclamation-circle me-1"></i>
          Esta accion no se puede deshacer. Todos los items de la repisa seran eliminados.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <form action="/shelf/{{shelf.id}}/delete" method="POST" class="d-inline">
          <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash me-2"></i>Si, Eliminar
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
