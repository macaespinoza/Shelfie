<!-- Pagina de registro -->
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <i class="bi bi-bookshelf fs-1 text-primary"></i>
            <h3 class="mt-2">Crear Cuenta</h3>
            <p class="text-muted">Unete a Shelfie y comparte tus favoritos</p>
          </div>

          <form action="/auth/register" method="POST" novalidate>
            <div class="mb-3">
              <label for="username" class="form-label">Nombre de usuario</label>
              <div class="input-group">
                <span class="input-group-text">@</span>
                <input
                  type="text"
                  class="form-control"
                  id="username"
                  name="username"
                  placeholder="mi_usuario"
                  value="{{formData.username}}"
                  pattern="^[a-zA-Z0-9_]+$"
                  minlength="3"
                  maxlength="30"
                  required
                  autofocus
                >
              </div>
              <div class="form-text">Solo letras, numeros y guiones bajos. 3-30 caracteres.</div>
            </div>

            <div class="mb-3">
              <label for="email" class="form-label">Correo electronico</label>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="bi bi-envelope"></i>
                </span>
                <input
                  type="email"
                  class="form-control"
                  id="email"
                  name="email"
                  placeholder="tu@email.com"
                  value="{{formData.email}}"
                  required
                >
              </div>
            </div>

            <div class="mb-3">
              <label for="password" class="form-label">Contrasena</label>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="bi bi-lock"></i>
                </span>
                <input
                  type="password"
                  class="form-control"
                  id="password"
                  name="password"
                  placeholder="Minimo 6 caracteres"
                  minlength="6"
                  required
                >
                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </div>

            <div class="mb-4">
              <label for="confirmPassword" class="form-label">Confirmar contrasena</label>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="bi bi-lock-fill"></i>
                </span>
                <input
                  type="password"
                  class="form-control"
                  id="confirmPassword"
                  name="confirmPassword"
                  placeholder="Repite tu contrasena"
                  minlength="6"
                  required
                >
              </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">
              <i class="bi bi-person-plus me-2"></i>Crear Cuenta
            </button>
          </form>

          <hr>

          <p class="text-center text-muted mb-0">
            Ya tienes cuenta?
            <a href="/auth/login" class="text-primary text-decoration-none">Iniciar sesion</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
