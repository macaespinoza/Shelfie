<!-- Pagina de detalle de post -->
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <!-- Boton volver -->
      <a href="/dashboard" class="btn btn-link text-muted p-0 mb-3">
        <i class="bi bi-arrow-left me-2"></i>Volver al feed
      </a>

      <!-- Post completo -->
      <div class="card bg-dark border-secondary mb-4">
        <div class="card-body">
          <!-- Header del post -->
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div class="d-flex align-items-center">
              <a href="/user/{{post.author.username}}" class="text-decoration-none">
                {{#if post.authorAvatar}}
                  <img src="{{post.authorAvatar}}" alt="{{post.author.username}}" class="rounded-circle me-3" width="48" height="48">
                {{else}}
                  <div class="avatar-placeholder-lg-sm me-3">{{substring post.author.username 0 1}}</div>
                {{/if}}
              </a>
              <div>
                <a href="/user/{{post.author.username}}" class="text-decoration-none text-white fw-medium fs-5">
                  {{post.author.username}}
                </a>
                <small class="text-muted d-block">{{post.timeAgo}}</small>
              </div>
            </div>

            {{#if isOwner}}
            <div class="dropdown">
              <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown">
                <i class="bi bi-three-dots-vertical fs-5"></i>
              </button>
              <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                <li>
                  <form action="/post/{{post.id}}/delete" method="POST" onsubmit="return confirm('Eliminar esta publicacion?')">
                    <button type="submit" class="dropdown-item text-danger">
                      <i class="bi bi-trash me-2"></i>Eliminar publicacion
                    </button>
                  </form>
                </li>
              </ul>
            </div>
            {{/if}}
          </div>

          <!-- Contenido del post -->
          {{#if post.content}}
          <p class="card-text fs-5 mb-4">{{post.content}}</p>
          {{/if}}

          <!-- Contenido compartido: Repisa -->
          {{#if post.sharedShelf}}
          <a href="/shelf/{{post.sharedShelf.id}}" class="text-decoration-none">
            <div class="shared-content shared-shelf rounded border border-secondary p-3 mb-4">
              <!-- Preview horizontal de repisa (8 thumbnails) -->
              <div class="shelf-preview-post mb-3">
                {{#if post.sharedShelf.previewImages.length}}
                  <div class="shelf-preview-row">
                    {{#each post.sharedShelf.previewImages}}
                      {{#if (lt @index 8)}}
                        <div class="shelf-preview-thumb" style="background-image: url('{{this}}')"></div>
                      {{/if}}
                    {{/each}}
                    {{#unless (gte post.sharedShelf.previewImages.length 8)}}
                      {{#times (subtract 8 post.sharedShelf.previewImages.length)}}
                        <div class="shelf-preview-thumb-empty">
                          <i class="bi {{../../post.sharedShelf.categoryInfo.icon}}"></i>
                        </div>
                      {{/times}}
                    {{/unless}}
                  </div>
                {{else}}
                  <div class="shelf-preview-horizontal-empty">
                    <i class="bi {{post.sharedShelf.categoryInfo.icon}} fs-1 text-{{post.sharedShelf.categoryInfo.color}}"></i>
                  </div>
                {{/if}}
              </div>
              <div class="d-flex align-items-center justify-content-between">
                <div>
                  <span class="badge bg-{{post.sharedShelf.categoryInfo.color}} mb-2">
                    <i class="bi {{post.sharedShelf.categoryInfo.icon}} me-1"></i>{{post.sharedShelf.categoryInfo.name}}
                  </span>
                  <h5 class="text-white mb-2">{{post.sharedShelf.name}}</h5>
                  <small class="text-muted">
                    <i class="bi bi-collection me-1"></i>{{post.sharedShelf.itemCount}} items
                    <span class="mx-2">·</span>
                    <i class="bi bi-person me-1"></i>{{post.sharedShelf.owner.username}}
                  </small>
                </div>
                <i class="bi bi-chevron-right text-muted fs-4"></i>
              </div>
            </div>
          </a>
          {{/if}}

          <!-- Contenido compartido: Item -->
          {{#if post.sharedItem}}
          <a href="/shelf/{{post.sharedItem.shelf.id}}" class="text-decoration-none">
            <div class="shared-content shared-item rounded border border-secondary p-4 mb-4">
              <div class="d-flex">
                {{#if post.sharedItem.imageUrl}}
                  <img src="{{post.sharedItem.imageUrl}}" alt="{{post.sharedItem.title}}" class="rounded me-4" width="120" height="180" style="object-fit: cover;">
                {{else}}
                  <div class="shared-item-placeholder-lg me-4">
                    <i class="bi {{post.sharedItem.shelf.categoryInfo.icon}} fs-1 text-{{post.sharedItem.shelf.categoryInfo.color}}"></i>
                  </div>
                {{/if}}
                <div>
                  <span class="badge bg-{{post.sharedItem.shelf.categoryInfo.color}} mb-2">
                    <i class="bi {{post.sharedItem.shelf.categoryInfo.icon}} me-1"></i>{{post.sharedItem.shelf.categoryInfo.name}}
                  </span>
                  <h5 class="text-white mb-2">{{post.sharedItem.title}}</h5>
                  {{#if post.sharedItem.rating}}
                    <span class="badge bg-warning text-dark mb-2">
                      <i class="bi bi-star-fill me-1"></i>{{post.sharedItem.rating}}/10
                    </span>
                  {{/if}}
                  {{#if post.sharedItem.review}}
                    <p class="text-muted mb-0">{{post.sharedItem.review}}</p>
                  {{/if}}
                </div>
              </div>
            </div>
          </a>
          {{/if}}

          <!-- Acciones del post -->
          <div class="post-actions d-flex align-items-center border-top border-bottom border-secondary py-3">
            <button
              class="btn btn-link text-decoration-none p-0 me-4 like-btn {{#if post.hasLiked}}text-danger{{else}}text-muted{{/if}}"
              data-post-id="{{post.id}}"
              data-liked="{{post.hasLiked}}"
            >
              <i class="bi {{#if post.hasLiked}}bi-heart-fill{{else}}bi-heart{{/if}} fs-5 me-2"></i>
              <span class="like-count">{{post.likeCount}}</span> {{pluralize post.likeCount "like" "likes"}}
            </button>

            <span class="text-muted">
              <i class="bi bi-chat fs-5 me-2"></i>
              {{post.commentCount}} {{pluralize post.commentCount "comentario" "comentarios"}}
            </span>
          </div>
        </div>
      </div>

      <!-- Seccion de comentarios -->
      <div class="card bg-dark border-secondary">
        <div class="card-header">
          <h5 class="mb-0">
            <i class="bi bi-chat-dots me-2"></i>Comentarios ({{post.commentCount}})
          </h5>
        </div>
        <div class="card-body">
          <!-- Formulario de nuevo comentario -->
          <form action="/post/{{post.id}}/comment" method="POST" class="mb-4">
            <div class="d-flex">
              {{#if currentUser.avatar}}
                <img src="{{currentUser.avatar}}" alt="Tu avatar" class="rounded-circle me-3" width="40" height="40">
              {{else}}
                <div class="avatar-placeholder me-3">{{substring currentUser.username 0 1}}</div>
              {{/if}}
              <div class="flex-grow-1">
                <textarea
                  class="form-control bg-dark border-secondary mb-2"
                  name="content"
                  rows="2"
                  placeholder="Escribe un comentario..."
                  maxlength="1000"
                  required
                ></textarea>
                <button type="submit" class="btn btn-primary btn-sm">
                  <i class="bi bi-send me-2"></i>Comentar
                </button>
              </div>
            </div>
          </form>

          <!-- Lista de comentarios -->
          {{#if post.comments.length}}
          <div class="comments-list">
            {{#each post.comments}}
            <div class="comment d-flex mb-3 pb-3 border-bottom border-secondary">
              <a href="/user/{{author.username}}" class="text-decoration-none">
                {{#if authorAvatar}}
                  <img src="{{authorAvatar}}" alt="{{author.username}}" class="rounded-circle me-3" width="40" height="40">
                {{else}}
                  <div class="avatar-placeholder me-3">{{substring author.username 0 1}}</div>
                {{/if}}
              </a>
              <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <a href="/user/{{author.username}}" class="text-decoration-none text-white fw-medium">
                      {{author.username}}
                    </a>
                    <small class="text-muted ms-2">{{timeAgo}}</small>
                  </div>
                  {{#if (or (eq author.id @root.currentUser.id) (eq @root.post.author.id @root.currentUser.id))}}
                  <form action="/post/comment/{{id}}/delete" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-link text-muted p-0" onclick="return confirm('Eliminar comentario?')">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                  {{/if}}
                </div>
                <p class="mb-0 mt-1">{{content}}</p>
              </div>
            </div>
            {{/each}}
          </div>
          {{else}}
          <div class="text-center py-4">
            <i class="bi bi-chat-dots fs-1 text-muted"></i>
            <p class="text-muted mt-2">No hay comentarios aun. Se el primero en comentar.</p>
          </div>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</div>
