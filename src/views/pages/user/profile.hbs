<!-- Perfil de usuario -->
<div class="profile-page">
  <!-- Portada -->
  <div class="profile-cover" style="{{#if profile.coverUrl}}background-image: url('{{profile.coverUrl}}'){{/if}}">
    <div class="profile-cover-overlay"></div>
  </div>

  <div class="container">
    <div class="profile-header">
      <div class="row align-items-end">
        <div class="col-auto">
          <!-- Avatar -->
          <div class="profile-avatar-container">
            {{#if profile.avatarUrl}}
              <img src="{{profile.avatarUrl}}" alt="{{profile.username}}" class="profile-avatar">
            {{else}}
              <div class="profile-avatar-placeholder">
                {{substring profile.username 0 1}}
              </div>
            {{/if}}
          </div>
        </div>
        <div class="col">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end">
            <div>
              <h2 class="mb-1">{{profile.username}}</h2>
              {{#if profile.bio}}
                <p class="text-muted mb-2">{{profile.bio}}</p>
              {{/if}}
              <div class="d-flex flex-wrap gap-3 text-muted small">
                <span>
                  <i class="bi bi-calendar3 me-1"></i>
                  Miembro desde {{formatDate profile.created_at}}
                </span>
                <a href="/user/{{profile.username}}/friends" class="text-muted text-decoration-none">
                  <i class="bi bi-people me-1"></i>
                  <strong>{{friendsCount}}</strong> {{pluralize friendsCount "amigo" "amigos"}}
                </a>
                {{#if mutualFriendsCount}}
                <span class="text-info">
                  <i class="bi bi-person-check me-1"></i>
                  {{mutualFriendsCount}} {{pluralize mutualFriendsCount "amigo" "amigos"}} en comun
                </span>
                {{/if}}
              </div>
            </div>
            <div class="mt-3 mt-md-0">
              {{#if isOwnProfile}}
                <a href="/user/edit" class="btn btn-outline-primary">
                  <i class="bi bi-pencil me-2"></i>Editar Perfil
                </a>
              {{else}}
                <!-- Botones de amistad -->
                <div class="friendship-actions" data-user-id="{{profile.id}}">
                  {{#if (eq relationshipStatus.status 'none')}}
                    <button class="btn btn-primary friendship-btn" data-action="add" data-user-id="{{profile.id}}">
                      <i class="bi bi-person-plus me-2"></i>Agregar Amigo
                    </button>
                  {{/if}}

                  {{#if (eq relationshipStatus.status 'request_sent')}}
                    <button class="btn btn-secondary friendship-btn" data-action="cancel" data-friendship-id="{{relationshipStatus.friendshipId}}">
                      <i class="bi bi-clock me-2"></i>Solicitud Enviada
                    </button>
                  {{/if}}

                  {{#if (eq relationshipStatus.status 'request_received')}}
                    <div class="btn-group">
                      <button class="btn btn-success friendship-btn" data-action="accept" data-friendship-id="{{relationshipStatus.friendshipId}}">
                        <i class="bi bi-check-lg me-2"></i>Aceptar
                      </button>
                      <button class="btn btn-outline-danger friendship-btn" data-action="reject" data-friendship-id="{{relationshipStatus.friendshipId}}">
                        <i class="bi bi-x-lg"></i>
                      </button>
                    </div>
                  {{/if}}

                  {{#if (eq relationshipStatus.status 'friends')}}
                    <div class="dropdown">
                      <button class="btn btn-success dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="bi bi-people-fill me-2"></i>Amigos
                      </button>
                      <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                        <li>
                          <button class="dropdown-item friendship-btn" data-action="remove" data-friend-id="{{profile.id}}">
                            <i class="bi bi-person-dash me-2"></i>Eliminar amigo
                          </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                          <button class="dropdown-item text-danger friendship-btn" data-action="block" data-target-id="{{profile.id}}">
                            <i class="bi bi-slash-circle me-2"></i>Bloquear
                          </button>
                        </li>
                      </ul>
                    </div>
                  {{/if}}

                  {{#if (eq relationshipStatus.status 'blocked_by_you')}}
                    <button class="btn btn-outline-secondary friendship-btn" data-action="unblock" data-target-id="{{profile.id}}">
                      <i class="bi bi-slash-circle me-2"></i>Desbloquear
                    </button>
                  {{/if}}

                  {{#if (eq relationshipStatus.status 'blocked_by_them')}}
                    <button class="btn btn-secondary" disabled>
                      <i class="bi bi-slash-circle me-2"></i>No disponible
                    </button>
                  {{/if}}
                </div>
              {{/if}}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Seccion de amigos mutuos (solo si hay y no es tu perfil) -->
    {{#if (and mutualFriendsCount (not isOwnProfile))}}
    <div class="row mt-4">
      <div class="col-12">
        <div class="card mb-4">
          <div class="card-body">
            <h6 class="mb-3">
              <i class="bi bi-person-check me-2 text-info"></i>
              {{mutualFriendsCount}} {{pluralize mutualFriendsCount "amigo" "amigos"}} en comun
            </h6>
            <div class="d-flex flex-wrap gap-2">
              {{#each mutualFriends}}
              <a href="/user/{{username}}" class="text-decoration-none">
                <div class="d-flex align-items-center bg-dark rounded-pill px-3 py-2">
                  {{#if avatar}}
                    <img src="/uploads/avatars/{{avatar}}" alt="{{username}}" class="rounded-circle me-2" width="24" height="24">
                  {{else}}
                    <div class="avatar-placeholder-xs me-2">{{substring username 0 1}}</div>
                  {{/if}}
                  <span class="text-white small">{{username}}</span>
                </div>
              </a>
              {{/each}}
              {{#if (gt mutualFriendsCount 3)}}
              <span class="text-muted small align-self-center ms-2">
                y {{subtract mutualFriendsCount 3}} mas...
              </span>
              {{/if}}
            </div>
          </div>
        </div>
      </div>
    </div>
    {{/if}}

    <!-- Alerta si el usuario esta bloqueado por ti -->
    {{#if isBlocked}}
    <div class="row mt-4">
      <div class="col-12">
        <div class="alert alert-secondary d-flex align-items-center">
          <i class="bi bi-slash-circle me-2"></i>
          <span>Has bloqueado a este usuario. No puedes ver su contenido.</span>
        </div>
      </div>
    </div>
    {{/if}}

    <!-- Contenido del perfil - Repisas -->
    {{#unless isBlocked}}
    <div class="row mt-4">
      <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="mb-0">
            <i class="bi bi-bookshelf me-2"></i>Repisas
          </h4>
          {{#if isOwnProfile}}
            <a href="/shelf/create" class="btn btn-primary">
              <i class="bi bi-plus-lg me-2"></i>Nueva Repisa
            </a>
          {{/if}}
        </div>

        {{#if shelves.length}}
        <!-- Grid de repisas (2 columnas, layout horizontal) -->
        <div class="row g-4">
          {{#each shelves}}
          <div class="col-md-6">
            <a href="/shelf/{{id}}" class="text-decoration-none">
              <div class="card h-100 shelf-card-horizontal">
                <!-- Preview horizontal de thumbnails (hasta 8) -->
                <div class="shelf-preview-horizontal">
                  {{#if previewImages.length}}
                    <div class="shelf-preview-row">
                      {{#each previewImages}}
                        <div class="shelf-preview-thumb" style="background-image: url('{{this}}')"></div>
                      {{/each}}

                    </div>
                  {{else}}
                    <div class="shelf-preview-horizontal-empty">
                      <i class="bi {{categoryInfo.icon}} fs-1 text-{{categoryInfo.color}}"></i>
                    </div>
                  {{/if}}

                  <!-- Badge de categoria -->
                  <span class="shelf-category-badge badge bg-{{categoryInfo.color}}">
                    <i class="bi {{categoryInfo.icon}} me-1"></i>{{categoryInfo.name}}
                  </span>

                  <!-- Badge de visibilidad -->
                  {{#if (eq visibility 'friends')}}
                    <span class="shelf-private-badge badge bg-primary">
                      <i class="bi bi-people"></i>
                    </span>
                  {{else if (eq visibility 'private')}}
                    <span class="shelf-private-badge badge bg-secondary">
                      <i class="bi bi-lock"></i>
                    </span>
                  {{else}}
                    {{#unless isPublic}}
                      <span class="shelf-private-badge badge bg-secondary">
                        <i class="bi bi-lock"></i>
                      </span>
                    {{/unless}}
                  {{/if}}
                </div>

                <div class="card-body">
                  <h5 class="card-title text-white mb-1">{{name}}</h5>
                  {{#if description}}
                    <p class="card-text text-muted small text-truncate-2">{{description}}</p>
                  {{/if}}
                  <small class="text-muted">
                    <i class="bi bi-collection me-1"></i>
                    {{itemCount}} {{pluralize itemCount "item" "items"}}
                  </small>
                </div>
              </div>
            </a>
          </div>
          {{/each}}
        </div>
        {{else}}
        <!-- Estado vacio -->
        <div class="card">
          <div class="card-body text-center py-5">
            <i class="bi bi-bookshelf fs-1 text-muted"></i>
            <h5 class="mt-3">
              {{#if isOwnProfile}}
                Aun no tienes repisas
              {{else}}
                {{profile.username}} aun no tiene repisas
              {{/if}}
            </h5>
            <p class="text-muted">
              {{#if isOwnProfile}}
                Crea tu primera repisa para comenzar a organizar tus favoritos.
              {{else}}
                Vuelve pronto para ver sus colecciones.
              {{/if}}
            </p>
            {{#if isOwnProfile}}
              <a href="/shelf/create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-2"></i>Crear Primera Repisa
              </a>
            {{/if}}
          </div>
        </div>
        {{/if}}
      </div>
    </div>
    {{/unless}}
  </div>
</div>
