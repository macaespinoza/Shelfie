<!-- Barra de navegacion -->
<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
  <div class="container">
    <!-- Logo y nombre -->
    <a class="navbar-brand d-flex align-items-center" href="{{#if isAuthenticated}}/dashboard{{else}}/{{/if}}">
      <svg class="navbar-logo-svg me-2" width="32" height="32" viewBox="0 0 900 900" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="shelfie-logo-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#67fac1;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#cc84eb;stop-opacity:1" />
          </linearGradient>
        </defs>
        <g transform="translate(0,900) scale(0.1,-0.1)" class="logo-paths">
          <path d="M2075 8220 c-199 -53 -309 -124 -429 -275 -17 -22 -37 -49 -43 -60 -25 -40 -83 -166 -83 -180 0 -8 -7 -40 -15 -72 -13 -49 -15 -239 -15 -1405 0 -1322 0 -1347 19 -1358 14 -7 959 -10 2981 -10 2022 0 2967 3 2981 10 19 11 19 36 19 1356 0 1329 0 1347 -21 1432 -27 114 -70 204 -139 292 -111 141 -244 226 -421 269 -87 21 -87 21 -2425 20 -2245 -1 -2342 -1 -2409 -19z m1061 -1136 c87 -40 155 -109 200 -199 18 -38 19 -66 19 -710 l0 -670 -24 -45 c-54 -103 -125 -165 -228 -201 -172 -59 -373 29 -456 200 l-22 46 0 670 c0 650 1 671 20 710 55 111 150 194 245 216 59 13 202 4 246 -17z m1156 -16 c79 -43 149 -126 178 -211 19 -59 20 -83 20 -684 0 -662 1 -645 -47 -738 -29 -55 -106 -126 -173 -158 -51 -24 -82 -32 -141 -35 -67 -4 -84 0 -150 27 -78 32 -158 102 -192 166 -47 87 -47 90 -47 743 0 599 1 619 21 677 35 101 95 172 183 217 62 32 93 37 193 34 82 -3 97 -7 155 -38z m1093 16 c126 -59 197 -153 245 -329 5 -16 14 -46 21 -65 6 -19 17 -51 24 -70 7 -19 18 -51 24 -70 7 -19 16 -48 21 -65 5 -16 14 -46 21 -65 6 -19 17 -51 24 -70 7 -19 18 -51 24 -70 7 -19 16 -48 21 -65 5 -16 14 -46 21 -65 6 -19 17 -51 24 -70 7 -19 20 -57 29 -85 75 -229 -113 -485 -357 -485 -99 0 -195 40 -266 111 -58 58 -76 93 -122 239 -12 36 -25 75 -30 87 -4 13 -51 152 -103 310 -53 159 -100 302 -106 318 -54 151 -104 312 -115 367 -35 194 79 375 270 429 50 14 195 3 240 -17z"/>
          <path d="M1508 4109 c-17 -9 -18 -85 -18 -1357 0 -1166 2 -1356 15 -1405 8 -32 15 -64 15 -72 0 -14 58 -140 83 -180 39 -63 125 -158 182 -202 82 -62 157 -96 290 -133 68 -19 128 -20 2410 -20 2262 0 2342 1 2415 19 199 50 313 123 434 276 64 82 108 175 135 287 21 85 21 103 21 1432 0 1320 0 1345 -19 1356 -27 14 -5939 14 -5963 -1z m3459 -1134 c68 -22 102 -42 152 -89 54 -51 82 -96 104 -165 15 -48 17 -118 17 -670 0 -598 -1 -618 -21 -676 -37 -105 -94 -171 -193 -223 -46 -24 -61 -27 -161 -27 -100 0 -115 3 -161 27 -99 52 -159 121 -195 225 -18 53 -19 89 -19 680 l0 624 31 74 c59 142 191 233 341 234 32 1 79 -6 105 -14z m1137 -5 c108 -38 170 -92 224 -193 l27 -52 0 -670 c0 -650 -1 -671 -20 -710 -45 -91 -98 -145 -195 -200 -51 -28 -249 -28 -300 0 -93 53 -141 100 -195 195 -19 34 -20 53 -20 710 l0 675 27 51 c35 67 70 108 125 145 98 68 220 86 327 49z"/>
        </g>
      </svg>
      <span class="fw-bold">Shelfie</span>
    </a>

    <!-- Boton hamburguesa para movil -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Contenido del navbar -->
    <div class="collapse navbar-collapse" id="navbarMain">
      {{#if isAuthenticated}}
      <!-- Menu para usuarios autenticados -->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link" href="/dashboard">
            <i class="bi bi-house-door me-1"></i>Inicio
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/user/{{currentUser.username}}">
            <i class="bi bi-bookshelf me-1"></i>Mis Repisas
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link position-relative" href="/friends">
            <i class="bi bi-people me-1"></i>Amigos
            {{#if pendingFriendRequests}}
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
              {{pendingFriendRequests}}
            </span>
            {{/if}}
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/chat">
            <i class="bi bi-chat-dots me-1"></i>Chat
          </a>
        </li>
      </ul>

      <!-- Barra de busqueda -->
      <form class="d-flex me-3" role="search" id="searchForm">
        <div class="input-group">
          <input class="form-control" type="search" placeholder="Buscar usuarios..." aria-label="Buscar" id="searchInput">
          <button class="btn btn-outline-secondary" type="submit">
            <i class="bi bi-search"></i>
          </button>
        </div>
      </form>

      <!-- Menu de usuario -->
      <ul class="navbar-nav">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            {{#if currentUser.avatar}}
              <img src="{{currentUser.avatar}}" alt="Avatar" class="rounded-circle me-2" width="32" height="32">
            {{else}}
              <div class="avatar-placeholder me-2">
                {{substring currentUser.username 0 1}}
              </div>
            {{/if}}
            <span>{{currentUser.username}}</span>
          </a>
          <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
            <li>
              <a class="dropdown-item" href="/user/{{currentUser.username}}">
                <i class="bi bi-person me-2"></i>Mi Perfil
              </a>
            </li>
            <li>
              <a class="dropdown-item" href="/user/edit">
                <i class="bi bi-gear me-2"></i>Configuracion
              </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <form action="/auth/logout" method="POST" class="d-inline">
                <button type="submit" class="dropdown-item text-danger">
                  <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesion
                </button>
              </form>
            </li>
          </ul>
        </li>
      </ul>

      {{else}}
      <!-- Menu para visitantes -->
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link" href="/auth/login">Iniciar Sesion</a>
        </li>
        <li class="nav-item">
          <a class="btn btn-primary ms-lg-2" href="/auth/register">Crear Cuenta</a>
        </li>
      </ul>
      {{/if}}
    </div>
  </div>
</nav>

<!-- Resultados de busqueda (contenedor oculto) -->
{{#if isAuthenticated}}
<div id="searchResults" class="search-results-container d-none">
  <div class="container">
    <div class="search-results-dropdown rounded shadow">
      <!-- Los resultados se cargan dinamicamente -->
    </div>
  </div>
</div>
{{/if}}
