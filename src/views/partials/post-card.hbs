<!-- Tarjeta de publicacion -->
<div class="card bg-dark border-secondary mb-3 post-card" data-post-id="{{id}}">
  <div class="card-body">
    <!-- Header del post -->
    <div class="d-flex justify-content-between align-items-start mb-3">
      <div class="d-flex align-items-center">
        <a href="/user/{{author.username}}" class="text-decoration-none">
          {{#if authorAvatar}}
            <img src="{{authorAvatar}}" alt="{{author.username}}" class="rounded-circle me-2" width="40" height="40">
          {{else}}
            <div class="avatar-placeholder-sm me-2">{{substring author.username 0 1}}</div>
          {{/if}}
        </a>
        <div>
          <a href="/user/{{author.username}}" class="text-decoration-none text-white fw-medium">
            {{author.username}}
          </a>
          <small class="text-muted d-block">{{timeAgo}}</small>
        </div>
      </div>

      {{#if (eq author.id @root.currentUser.id)}}
      <div class="dropdown">
        <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown">
          <i class="bi bi-three-dots"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
          <li>
            <form action="/post/{{id}}/delete" method="POST" onsubmit="return confirm('Eliminar esta publicacion?')">
              <button type="submit" class="dropdown-item text-danger">
                <i class="bi bi-trash me-2"></i>Eliminar
              </button>
            </form>
          </li>
        </ul>
      </div>
      {{/if}}
    </div>

    <!-- Contenido del post -->
    {{#if content}}
    <p class="card-text mb-3 post-content">{{content}}</p>
    {{/if}}

    <!-- Contenido compartido: Repisa -->
    {{#if sharedShelf}}
    <a href="/shelf/{{sharedShelf.id}}" class="text-decoration-none">
      <div class="shared-content shared-shelf rounded border border-secondary p-3 mb-4">
        <!-- Preview horizontal de repisa (6 thumbnails) -->
        <div class="shelf-preview-dashboard mb-3 {{#unless (or (eq sharedShelf.category 'music') (eq sharedShelf.category 'podcasts'))}}portrait{{/unless}}">
          {{#if sharedShelf.previewImages.length}}
            <div class="shelf-preview-row">
              {{#each sharedShelf.previewImages}}
                {{#if (lt @index 6)}}
                  <div class="shelf-preview-thumb" style="background-image: url('{{this}}')"></div>
                {{/if}}
              {{/each}}
              {{#unless (gte sharedShelf.previewImages.length 6)}}
                {{#times (subtract 6 sharedShelf.previewImages.length)}}
                  <div class="shelf-preview-thumb-empty">
                    <i class="bi {{../../sharedShelf.categoryInfo.icon}}"></i>
                  </div>
                {{/times}}
              {{/unless}}
            </div>
          {{else}}
            <div class="shelf-preview-horizontal-empty" style="height: 70px;">
              <i class="bi {{sharedShelf.categoryInfo.icon}} fs-2 text-{{sharedShelf.categoryInfo.color}}"></i>
            </div>
          {{/if}}
        </div>
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="badge bg-{{sharedShelf.categoryInfo.color}} mb-2">
              <i class="bi {{sharedShelf.categoryInfo.icon}} me-1"></i>{{sharedShelf.categoryInfo.name}}
            </span>
            <h6 class="text-white mb-1">{{sharedShelf.name}}</h6>
            <small class="text-muted">
              <i class="bi bi-collection me-1"></i>{{sharedShelf.itemCount}} items
              {{#if sharedShelf.owner}}
              <span class="mx-2">·</span>
              <i class="bi bi-person me-1"></i>{{sharedShelf.owner.username}}
              {{/if}}
            </small>
          </div>
          <i class="bi bi-chevron-right text-muted"></i>
        </div>
      </div>
    </a>
    {{/if}}

    <!-- Contenido compartido: Item -->
    {{#if sharedItem}}
    <a href="/shelf/{{sharedItem.shelf.id}}" class="text-decoration-none">
      <div class="shared-content shared-item rounded border border-secondary p-4 mb-4">
        <div class="d-flex">
          {{#if sharedItem.imageUrl}}
            <img src="{{sharedItem.imageUrl}}" alt="{{sharedItem.title}}" class="rounded me-4" width="120" height="180" style="object-fit: cover;">
          {{else}}
            <div class="shared-item-placeholder-lg me-4">
              <i class="bi {{sharedItem.shelf.categoryInfo.icon}} fs-1 text-{{sharedItem.shelf.categoryInfo.color}}"></i>
            </div>
          {{/if}}
          <div>
            <span class="badge bg-{{sharedItem.shelf.categoryInfo.color}} mb-2">
              <i class="bi {{sharedItem.shelf.categoryInfo.icon}} me-1"></i>{{sharedItem.shelf.categoryInfo.name}}
            </span>
            <h5 class="text-white mb-2">{{sharedItem.title}}</h5>
            {{#if sharedItem.rating}}
              <span class="badge bg-warning text-dark mb-2">
                <i class="bi bi-star-fill me-1"></i>{{sharedItem.rating}}/10
              </span>
            {{/if}}
            {{#if sharedItem.review}}
              <p class="text-muted mb-0 text-truncate-3">{{sharedItem.review}}</p>
            {{/if}}
          </div>
        </div>
      </div>
    </a>
    {{/if}}

    <!-- Acciones del post -->
    <div class="post-actions d-flex align-items-center border-top border-secondary pt-3">
      <!-- Like -->
      <button
        class="btn btn-link text-decoration-none p-0 me-4 like-btn {{#if hasLiked}}text-danger{{else}}text-muted{{/if}}"
        data-post-id="{{id}}"
        data-liked="{{hasLiked}}"
      >
        <i class="bi {{#if hasLiked}}bi-heart-fill{{else}}bi-heart{{/if}} me-1"></i>
        <span class="like-count">{{likeCount}}</span>
      </button>

      <!-- Comentarios -->
      <a href="/post/{{id}}" class="btn btn-link text-decoration-none text-muted p-0 me-4">
        <i class="bi bi-chat me-1"></i>
        <span>{{commentCount}}</span>
      </a>

      <!-- Enlace al post -->
      <a href="/post/{{id}}" class="btn btn-link text-decoration-none text-muted p-0 ms-auto">
        <i class="bi bi-box-arrow-up-right"></i>
      </a>
    </div>

    <!-- Preview de comentarios -->
    {{#if comments.length}}
    <div class="post-comments-preview mt-3 pt-3 border-top border-secondary">
      {{#each comments}}
      <div class="comment-preview d-flex mb-2">
        <a href="/user/{{author.username}}" class="text-decoration-none">
          {{#if authorAvatar}}
            <img src="{{authorAvatar}}" alt="{{author.username}}" class="rounded-circle me-2" width="24" height="24">
          {{else}}
            <div class="avatar-placeholder-sm me-2">{{substring author.username 0 1}}</div>
          {{/if}}
        </a>
        <div class="flex-grow-1">
          <a href="/user/{{author.username}}" class="text-decoration-none text-white fw-medium small">
            {{author.username}}
          </a>
          <span class="text-muted small ms-1">{{content}}</span>
        </div>
      </div>
      {{/each}}

      {{#if (gt commentCount 3)}}
      <a href="/post/{{id}}" class="text-muted small">Ver los {{commentCount}} comentarios</a>
      {{/if}}
    </div>
    {{/if}}

    <!-- Formulario de comentario rapido -->
    <form action="/post/{{id}}/comment" method="POST" class="comment-form mt-3">
      <div class="input-group input-group-sm">
        <input
          type="text"
          class="form-control bg-dark border-secondary"
          name="content"
          placeholder="Escribe un comentario..."
          maxlength="1000"
          required
        >
        <button type="submit" class="btn btn-outline-primary">
          <i class="bi bi-send"></i>
        </button>
      </div>
    </form>
  </div>
</div>
