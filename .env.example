# ========================================
# SHELFIE - Variables de Entorno
# ========================================
# Copia este archivo como .env y completa los valores

# Entorno (development, production)
NODE_ENV=production

# Puerto (Railway lo asigna automáticamente, no es necesario configurar)
# PORT=3000

# Base de datos PostgreSQL
# En Railway: se inyecta automáticamente al agregar PostgreSQL
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# Secreto para sesiones (genera una cadena aleatoria segura)
# Puedes generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=tu_secreto_super_seguro_aqui

# ========================================
# API Keys (configura según las que uses)
# ========================================

# Spotify API (para música)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# TMDB API (para películas/series)
# TMDB_API_KEY=

# Google Books API (para libros)
# GOOGLE_BOOKS_API_KEY=

# RAWG API (para videojuegos)
# RAWG_API_KEY=

# Podcast Index API (para podcasts)
# PODCAST_INDEX_API_KEY=
# PODCAST_INDEX_API_SECRET=
